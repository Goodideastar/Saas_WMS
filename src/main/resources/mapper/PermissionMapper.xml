<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wms.mapper.PermissionMapper">

    <resultMap id="BaseResultMap" type="com.wms.entity.Permission">
        <id column="id" property="id"/>
        <result column="permission_code" property="permissionCode"/>
        <result column="permission_name" property="permissionName"/>
        <result column="resource_type" property="resourceType"/>
        <result column="parent_id" property="parentId"/>
        <result column="path" property="path"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT id, permission_code, permission_name, resource_type, parent_id, path, status,
               create_time, update_time, is_deleted
        FROM permission WHERE id = #{id} AND is_deleted = 0
    </select>

    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT id, permission_code, permission_name, resource_type, parent_id, path, status,
               create_time, update_time, is_deleted
        FROM permission WHERE is_deleted = 0
        <if test="ids != null and ids.size() > 0">
            AND id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </select>

</mapper>
