<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wms.mapper.RoleMapper">

    <resultMap id="BaseResultMap" type="com.wms.entity.Role">
        <id column="id" property="id"/>
        <result column="role_code" property="roleCode"/>
        <result column="role_name" property="roleName"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT id, role_code, role_name, description, status, create_time, update_time, is_deleted
        FROM role WHERE id = #{id} AND is_deleted = 0
    </select>

    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT id, role_code, role_name, description, status, create_time, update_time, is_deleted
        FROM role WHERE is_deleted = 0
        <if test="ids != null and ids.size() > 0">
            AND id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </select>

</mapper>
