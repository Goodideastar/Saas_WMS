# LLM配置
LLM_PROVIDER=qwen
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# WMS后端地址
WMS_BASE_URL=http://localhost:8080

# Redis
REDIS_URL=redis://localhost:6379/0

# 服务端口
AI_GATEWAY_PORT=8090

# LangGraph
MAX_AGENT_LOOPS=5
RECURSION_LIMIT=25
