# ==================== WMS 环境变量配置模板 ====================
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 根据需要修改配置值
#   3. 运行: docker-compose up -d

# ==================== 数据库配置 ====================
# MySQL 根密码
MYSQL_ROOT_PASSWORD=wms123456

# 数据库名称
MYSQL_DATABASE=wms

# MySQL 端口（默认不修改）
MYSQL_PORT=3306

# ==================== Redis 配置 ====================
# Redis 端口（默认不修改）
REDIS_PORT=6379

# ==================== 后端配置 ====================
# 后端服务端口
BACKEND_PORT=8080

# JWT 密钥（生产环境请修改为强密钥）
JWT_SECRET=wms-jwt-secret-key-2024-very-long-secret-for-security

# ==================== 前端配置 ====================
# 前端服务端口
FRONTEND_PORT=80

# Vite API 基础 URL（代理转发路径）
VITE_API_BASE_URL=/api

# ==================== 其他配置 ====================
# 时区设置
TZ=Asia/Shanghai
