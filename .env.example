# ==================== WMS 环境变量配置模板 ====================
# 使用方法:
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 根据需要修改配置值
#   3. 运行: docker-compose up -d

# ==================== 数据库配置 ====================
# MySQL 根密码
MYSQL_ROOT_PASSWORD=wms123456

# 数据库名称
MYSQL_DATABASE=wms

# MySQL 端口（默认不修改）
MYSQL_PORT=3306

# ==================== Redis 配置 ====================
# Redis 端口（默认不修改）
REDIS_PORT=6379

# ==================== 后端配置 ====================
# 后端服务端口
BACKEND_PORT=8080

# JWT 密钥（生产环境请修改为强密钥）
JWT_SECRET=8f5k2m9p3x7q1v4b6n0z2r5t8y1u4i7o0e3w6a9s2d5f8g1j4h7k0l3p6u9c2b5n8q1v4x7z0a3d6f9h2j5l8o1r4t7w0y3

# ==================== 前端配置 ====================
# 前端服务端口
FRONTEND_PORT=80

# Vite API 基础 URL（代理转发路径）
VITE_API_BASE_URL=/api

# ==================== AI Gateway 配置 ====================
# LLM 提供商agnes
LLM_PROVIDER=agnes

# LLM API Key（必填，agnes)
LLM_API_KEY=sk-6pwb7jffxq7LRbww89I5EooQ3UqLgiF2WFKAGMYUtK72K8wx

# LLM API 基础 URL
LLM_BASE_URL=https://apihub.agnes-ai.cn/v1

# LLM 模型名称
LLM_MODEL=agnes-2.5-flash

# ==================== 其他配置 ====================
# 时区设置
TZ=Asia/Shanghai
